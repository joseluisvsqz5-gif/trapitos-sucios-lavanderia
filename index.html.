
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Acceso | TRAPITOS SUCIOS LAVANDERÍA</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; display: grid; place-items: center;
      padding: 20px; font-family: Arial, sans-serif;
      background: #edf3ef; color: #20332d;
    }
    main {
      width: 100%; max-width: 400px; padding: 26px;
      background: white; border-radius: 18px;
      box-shadow: 0 8px 30px #163d3018;
    }
    h1 { color: #123c35; font-size: 23px; }
    label { display: block; margin-top: 16px; font-weight: bold; }
    input, button {
      width: 100%; padding: 13px; margin-top: 7px;
      border-radius: 9px; font-size: 16px;
    }
    input { border: 1px solid #b8c8bf; }
    button {
      border: 0; background: #176b55; color: white;
      font-weight: bold; margin-top: 22px;
    }
    #mensaje { white-space: pre-wrap; line-height: 1.5; }
    .nota { color: #5a6d63; font-size: 13px; }
  </style>
</head>
<body>
  <main>
    <h1>TRAPITOS SUCIOS LAVANDERÍA</h1>
    <p>Acceso privado de administración</p>

    <form id="login">
      <label for="email">Correo del administrador</label>
      <input id="email" type="email" autocomplete="username"
        required>
      <label for="password">Contraseña</label>
      <input id="password" type="password"
        autocomplete="current-password" required>
      <button id="entrar" type="submit">Iniciar sesión</button>
    </form>

    <p id="mensaje" role="status"></p>
    <p class="nota">Solo pueden entrar las cuentas autorizadas.</p>
    <button id="salir" type="button" hidden>Cerrar sesión</button>
  </main>

  <script type="module">
    import { createClient } from
      'https://esm.sh/@supabase/supabase-js@2';

    const SUPABASE_URL = 'https://joseluisvsqz5-gif.github.io/trapitos-sucios-lavanderia/';
    const SUPABASE_KEY = 'sb_publishable_j4olSF8Jc4PEhu9G9w1JSw_x07QrVw4';

    const mensaje = document.querySelector('#mensaje');
    const formulario = document.querySelector('#login');
    const boton = document.querySelector('#entrar');
    const salir = document.querySelector('#salir');

    const configurado =
      SUPABASE_URL.startsWith('https://') &&
      SUPABASE_KEY.startsWith('sb_publishable_') &&
      !SUPABASE_URL.includes('PEGA_AQUI') &&
      !SUPABASE_KEY.includes('PEGA_AQUI');

    if (!configurado) {
      mensaje.textContent =
        'Falta configurar la URL y la clave publicable de Supabase.';
      boton.disabled = true;
    } else {
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

      formulario.addEventListener('submit', async (evento) => {
        evento.preventDefault();
        boton.disabled = true;
        mensaje.textContent = 'Verificando acceso…';

        const { error } = await supabase.auth.signInWithPassword({
          email: document.querySelector('#email').value.trim(),
          password: document.querySelector('#password').value
        });

        if (error) {
          mensaje.textContent =
            'No se pudo iniciar sesión. Revisa el correo y la contraseña.';
        } else {
          formulario.hidden = true;
          salir.hidden = false;
          mensaje.textContent =
            'Sesión iniciada. Verificando autorización administrativa…';

          const { data: esAdmin, error: errorAdmin } =
            await supabase.rpc('is_admin');

          if (errorAdmin || esAdmin !== true) {
            await supabase.auth.signOut();
            formulario.hidden = false;
            salir.hidden = true;
            mensaje.textContent =
              'Esta cuenta no tiene autorización administrativa.';
          } else {
            mensaje.textContent =
              'Acceso administrativo confirmado. El panel de gestión se añadirá en el siguiente paso.';
          }
        }
        boton.disabled = false;
      });

      salir.addEventListener('click', async () => {
        await supabase.auth.signOut();
        formulario.hidden = false;
        salir.hidden = true;
        mensaje.textContent = 'Sesión cerrada.';
      });

      const { data: { session } } =
        await supabase.auth.getSession();

      if (session) {
        mensaje.textContent =
          'Ya existe una sesión. Inicia sesión nuevamente para verificar el acceso.';
      }
    }
  </script>
</body>
</html>
