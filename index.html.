<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#123c35">
  <title>TRAPITOS SUCIOS LAVANDERÍA</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; padding: 20px;
      display: grid; place-items: center;
      font-family: Arial, sans-serif;
      background: #edf3ef; color: #20332d;
    }
    main {
      width: 100%; max-width: 400px; padding: 26px;
      background: white; border-radius: 18px;
      box-shadow: 0 8px 30px #163d3018;
    }
    h1 { color: #123c35; font-size: 23px; }
    p { line-height: 1.5; }
    label { display: block; margin-top: 16px; font-weight: bold; }
    input, button {
      width: 100%; padding: 13px; margin-top: 7px;
      border-radius: 9px; font-size: 16px;
    }
    input { border: 1px solid #b8c8bf; }
    button {
      border: 0; background: #176b55; color: white;
      font-weight: bold; cursor: pointer; margin-top: 20px;
    }
    button:disabled { opacity: .6; }
    #mensaje { overflow-wrap: anywhere; }
    .nota { font-size: 13px; color: #52665d; }
  </style>
</head>
<body>
  <main>
    <h1>TRAPITOS SUCIOS LAVANDERÍA</h1>
    <p>Acceso exclusivo para el administrador</p>

    <form id="login">
      <label for="correo">Correo electrónico</label>
      <input id="correo" type="email" autocomplete="username"
        required>

      <label for="clave">Contraseña</label>
      <input id="clave" type="password"
        autocomplete="current-password" required>

      <button id="entrar" type="submit">Iniciar sesión</button>
    </form>

    <p id="mensaje" role="status" aria-live="polite"></p>
    <p class="nota">Acceso restringido a personal autorizado.</p>
  </main>

  <script type="module">
    import { createClient } from
      'https://esm.sh/@supabase/supabase-js@2';

    const SUPABASE_URL = 'https://esm.sh/@supabase/supabase-js@2';
    const SUPABASE_KEY = 'sb_publishable_j4olSF8Jc4PEhu9G9w1JSw_x07QrVw4';

    const supabase = createClient(
      SUPABASE_URL,
      SUPABASE_KEY
    );

    const form = document.getElementById('login');
    const mensaje = document.getElementById('mensaje');
    const boton = document.getElementById('entrar');

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      boton.disabled = true;
      mensaje.textContent = 'Verificando acceso...';

      try {
        const email = document.getElementById('correo').value.trim();
        const password = document.getElementById('clave').value;

        const { error: loginError } =
          await supabase.auth.signInWithPassword({
            email,
            password
          });

        if (loginError) {
          throw new Error('No se pudo iniciar sesión. Revisa tu correo y contraseña.');
        }

        const { data: esAdmin, error: adminError } =
          await supabase.rpc('is_admin');

        if (adminError || esAdmin !== true) {
          await supabase.auth.signOut();
          throw new Error(
            'Acceso administrativo no confirmado. Revisa la configuración de permisos.'
          );
        }

        form.hidden = true;
        mensaje.textContent =
          'Acceso administrativo confirmado. El siguiente paso será crear el panel de gestión.';
      } catch (error) {
        mensaje.textContent = error.message ||
          'Ocurrió un error. Inténtalo nuevamente.';
      } finally {
        boton.disabled = false;
      }
    });
  </script>
</body>
</html>
